#!/usr/bin/env python3
# SPDX-License-Identifier: BSL-1.0
# Generates single/tacit/ — the single-file, copy-paste-vendorable forms of the public headers —
# from the canonical sources in include/tacit/. This script is the ONLY writer of single/; CI
# regenerates and diffs, so the outputs can neither drift nor be hand-edited.
#
# The outputs keep their tacit/ directory: `#include <tacit/_.hpp>` is the ONE include spelling
# tacit ever asks for, and vendoring a single file must not introduce a second one. Copy
# single/tacit/_.hpp in as tacit/_.hpp and the source that used the repo builds unchanged.
#
# Mechanics:
#   - tacit-relative quoted #includes are expanded in place; <system> includes are left alone.
#   - The shared core (_.hpp's content) is wrapped in TACIT_SINGLE_CORE_SEEN wherever it lands, so
#     the single _.hpp and $.hpp may be included together in one TU, in either order — #pragma
#     once is per-FILE and cannot dedupe content shared across two files.
#   - detail/make_overloads.hpp is expanded at EVERY inclusion site, never deduped: it is macro-only
#     and guard-free by design ($.hpp replays it after _.hpp has consumed and #undef'd it).
#   - λ.hpp is already standalone; it is passed through verbatim (banner aside) so the set is the
#     complete list of public headers.
import pathlib
import re

ROOT = pathlib.Path(__file__).resolve().parent.parent
INC = ROOT / "include" / "tacit"
OUT = ROOT / "single" / "tacit"  # the tacit/ level is load-bearing: it preserves the include spelling
GUARD = "TACIT_SINGLE_CORE_SEEN"
CORE = (INC / "_.hpp").resolve()
INCLUDE_RE = re.compile(r'^\s*#\s*include\s+"([^"]+)"\s*$')

def inline(path: pathlib.Path) -> list[str]:
    out: list[str] = []
    for line in path.read_text(encoding="utf-8").splitlines():
        m = INCLUDE_RE.match(line)
        if m:
            target = (path.parent / m.group(1)).resolve()
            if target == CORE:
                out += [f"#ifndef {GUARD}", f"#define {GUARD}"]
                out += inline(target)
                out += [f"#endif // {GUARD}"]
            else:
                out += inline(target)
        elif line.strip() == "#pragma once" or line.startswith("// SPDX-License-Identifier:"):
            continue
        else:
            out.append(line)
    return out

def emit(src: pathlib.Path, wrap_core: bool) -> None:
    body = ([f"#ifndef {GUARD}", f"#define {GUARD}"] + inline(src) + [f"#endif // {GUARD}"]
            if wrap_core else inline(src))
    text = "\n".join([
        "// SPDX-License-Identifier: BSL-1.0",
        f"// GENERATED by tools/amalgamate from include/tacit/{src.name} — DO NOT EDIT.",
        "// Single-file form: no other file is needed. Keep it at tacit/ in your include path and",
        f"// the spelling stays `#include <tacit/{src.name}>`, exactly as from the repo.",
        "// _.hpp and $.hpp may be included together, in either order — the shared core is",
        f"// deduplicated by {GUARD}.",
        "#pragma once",
    ] + body) + "\n"
    (OUT / src.name).write_text(text, encoding="utf-8")

OUT.mkdir(parents=True, exist_ok=True)
emit(INC / "_.hpp", wrap_core=True)
emit(INC / "$.hpp", wrap_core=False)  # its `#include "_.hpp"` gets the wrap during expansion
emit(INC / "λ.hpp", wrap_core=False)  # standalone already: pass-through
print("wrote", ", ".join(sorted(f"single/tacit/{p.name}" for p in OUT.iterdir())))
